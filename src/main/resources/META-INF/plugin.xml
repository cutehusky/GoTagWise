<idea-plugin>
  <id>dev.structtags.gotagwise</id>
  <name>GoTagWise</name>
  <version>0.1.0</version>
  <vendor>cutehusky</vendor>
  <idea-version since-build="262"/>
  <description><![CDATA[
    Smart completion, field-aware live templates, and inspections for Go struct tags.
    Supports JSON, XML, YAML, BSON, DynamoDB, env, Gin binding, HCL, MessagePack,
    GORM, Redis, TOML, validator, Bun, conform and Huma v2.
    Configure custom validation rules in the GoTagWise: Go struct tags inspection settings.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <depends>org.jetbrains.plugins.go</depends>
  <extensions defaultExtensionNs="com.intellij">
    <platform.backend.documentation.targetProvider implementation="dev.structtags.ide.StructTagDocumentationProvider"/>
    <completion.contributor language="go" implementationClass="dev.structtags.ide.StructTagCompletionContributor" order="first"/>
    <localInspection language="go" shortName="GoTagWise" displayName="GoTagWise: Go struct tags"
                     groupName="Struct tags" enabledByDefault="true" level="WARNING"
                     implementationClass="dev.structtags.ide.StructTagInspection"/>
    <liveTemplateContext contextId="GoTagWise" implementation="dev.structtags.ide.StructTagTemplateContext"/>
    <defaultLiveTemplatesProvider implementation="dev.structtags.ide.StructTagTemplates"/>
    <liveTemplateMacro implementation="dev.structtags.ide.StructTagNameMacro"/>
  </extensions>
</idea-plugin>
